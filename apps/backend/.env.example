# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ims_db?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
# Token expiration (s=seconds, m=minutes, h=hours, d=days)
# This value is used for BOTH JWT token AND cookie expiration
# Examples: 15m, 1h, 24h, 7d
# Recommended: 24h for development, 1h-4h for production
JWT_EXPIRATION="24h"

# Server
PORT=3001
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3000"

# File Upload
MAX_FILE_SIZE=5242880  # 5MB in bytes

# Cloudinary (Optional - for image/QR code storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Rate Limiting
RATE_LIMIT_TTL=60000  # 1 minute in ms
RATE_LIMIT_MAX=100    # Max requests per TTL
