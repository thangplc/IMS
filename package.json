{
  "name": "inventory-management-system",
  "version": "1.0.0",
  "description": "Full-stack Inventory Management System",
  "private": true,
  "scripts": {
    "dev:backend": "cd apps/backend && npm run start:dev",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "cd apps/backend && npm run build",
    "build:frontend": "cd apps/frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "prisma:studio": "cd apps/backend && npm run prisma:studio",
    "prisma:migrate": "cd apps/backend && npm run prisma:migrate",
    "prisma:seed": "cd apps/backend && npm run prisma:seed"
  },
  "keywords": [
    "inventory",
    "management",
    "nextjs",
    "nestjs",
    "prisma",
    "postgresql"
  ],
  "author": "Thang PLC",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
